generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id         String      @id @default(cuid())
  eventName  String
  eventType  EventType
  eventCause String?
  crowdSize  Int         @default(0)
  location   String
  latitude   Decimal     @db.Decimal(10, 7)
  longitude  Decimal     @db.Decimal(10, 7)
  startTime  DateTime
  endTime    DateTime
  status     EventStatus @default(SCHEDULED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  prediction Prediction?

  @@index([eventType])
  @@index([status])
  @@index([startTime])
}

model Prediction {
  id                String   @id @default(cuid())
  eventId           String?  @unique
  severityScore     Float
  hotspotScore      Float
  junctionScore     Float
  closureScore      Float
  riskScore         Float
  trafficScore      Float
  riskCategory      String
  officers          Int
  barricades        Int
  towVehicles       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  diversionStrategy Json?
  event             Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model IncidentReport {
  id              String   @id @default(cuid())
  title           String
  status          String   @default("Pending Verification")
  severity        String   @default("Moderate")
  location        String
  submittedAt     DateTime @default(now())
  affectedLanes   Int      @default(1)
  progress        Int      @default(1)
  description     String?
  estimatedPeople Int      @default(0)
  roadClosed      Boolean  @default(false)
  clerkId         String?
  photoUrl        String?

  @@index([status])
}

enum Role {
  USER
  OFFICER
}

enum EventType {
  FESTIVAL
  CONCERT
  SPORTS
  POLITICAL
  RELIGIOUS
  CORPORATE
  EDUCATIONAL
  OTHER
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}
